\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces MZM validation. A: Transfer function -- $\cos ^2(\pi V/2V_\pi )$ verified for push-pull and single-drive. B: Phase response (chirp) -- push-pull has zero chirp; single-drive has linear chirp $\phi = \pi V/2V_\pi $. C: Extinction ratio effect (ideal, 20~dB, 10~dB). D: Insertion loss scaling as $10^{-\text  {IL}/10}$. E: Crystal cut -- X-cut modulates Ey; Y-cut modulates Ex.}}{12}{figure.caption.4}\protected@file@percent }
\newlabel{fig:mzm}{{2}{12}{MZM validation. A: Transfer function -- $\cos ^2(\pi V/2V_\pi )$ verified for push-pull and single-drive. B: Phase response (chirp) -- push-pull has zero chirp; single-drive has linear chirp $\phi = \pi V/2V_\pi $. C: Extinction ratio effect (ideal, 20~dB, 10~dB). D: Insertion loss scaling as $10^{-\text {IL}/10}$. E: Crystal cut -- X-cut modulates Ey; Y-cut modulates Ex}{figure.caption.4}{}}

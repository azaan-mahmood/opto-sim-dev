\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Convergence of the multi-section model to uniform SU(2) on the Poincar\'e sphere (500 realisations per distance, input $E_x=1,\tmspace  +\thickmuskip {.2777em}E_y=0$, $\Delta n_0 = 5\times 10^{-8}$). At $L = 0.01$~km the points cluster near the input state $(S_1,S_2,S_3)=(1,0,0)$; by $L = 1$~km the distribution is nearly uniform ($|\langle \mathbf  {S}\rangle | = 0.02$), and further propagation does not change the statistics. The QBER under this model therefore saturates at $\sim $50\% within the first kilometre, motivating the phenomenological model for long-haul BB84.}}{18}{figure.caption.14}\protected@file@percent }
\newlabel{fig:biref-conv}{{7}{18}{Convergence of the multi-section model to uniform SU(2) on the Poincar\'e sphere (500 realisations per distance, input $E_x=1,\;E_y=0$, $\Delta n_0 = 5\times 10^{-8}$). At $L = 0.01$~km the points cluster near the input state $(S_1,S_2,S_3)=(1,0,0)$; by $L = 1$~km the distribution is nearly uniform ($|\langle \mathbf {S}\rangle | = 0.02$), and further propagation does not change the statistics. The QBER under this model therefore saturates at $\sim $50\% within the first kilometre, motivating the phenomenological model for long-haul BB84}{figure.caption.14}{}}

\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Attenuation validation. Power vs distance for SMF-28 at 1550~nm ($\alpha = 0.182$~dB/km). Error: $<10^{-13}\%$ across 0--200~km.}}{14}{figure.caption.10}\protected@file@percent }
\newlabel{fig:att}{{5}{14}{Attenuation validation. Power vs distance for SMF-28 at 1550~nm ($\alpha = 0.182$~dB/km). Error: $<10^{-13}\%$ across 0--200~km}{figure.caption.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Birefringence validation (random-axis model). A: Mean output $|E_x|^2$ vs fibre length\ --- the diffusive random walk gradually scrambles the polarisation from $|E_x|^2 = 1$ to the uniformly mixed limit $|E_x|^2 = 0.5$. B: Net rotation angle vs temperature at 1~km ($\theta $ depends on $\Delta n(T)$ through $L_{\text  {char}}$). C: Characteristic length $L_{\text  {char}}$ vs bend radius; tight bends ($R < 5$~mm) reduce $L_{\text  {char}}$ by orders of magnitude. D: Beat length $L_B = \lambda /\Delta n_0$ vs wavelength (Agrawal Eq.~4.1.2). E: Deterministic $\Delta n$ components showing temperature dependence and bend contributions.}}{14}{figure.caption.12}\protected@file@percent }
\newlabel{fig:biref}{{6}{14}{Birefringence validation (random-axis model). A: Mean output $|E_x|^2$ vs fibre length\ --- the diffusive random walk gradually scrambles the polarisation from $|E_x|^2 = 1$ to the uniformly mixed limit $|E_x|^2 = 0.5$. B: Net rotation angle vs temperature at 1~km ($\theta $ depends on $\Delta n(T)$ through $L_{\text {char}}$). C: Characteristic length $L_{\text {char}}$ vs bend radius; tight bends ($R < 5$~mm) reduce $L_{\text {char}}$ by orders of magnitude. D: Beat length $L_B = \lambda /\Delta n_0$ vs wavelength (Agrawal Eq.~4.1.2). E: Deterministic $\Delta n$ components showing temperature dependence and bend contributions}{figure.caption.12}{}}

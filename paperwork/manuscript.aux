\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces CW laser validation. A: Power calibration ($\langle |E|^2\rangle $ vs $P_{\text  {dBm}}$). B: Phase diffusion (cumulative squared phase increments $\DOTSB \sum@ \slimits@ \Delta \phi ^2$ vs $D_\phi t$). C: Phase increment PDF (Gaussian fit). D: RIN spectral density with relaxation-oscillation peak at 5~GHz (Coldren Eq.~5.3.38). E: Polarisation Jones vector ($|E_x|$, $|E_y|$, norm).}}{10}{figure.caption.2}\protected@file@percent }
\newlabel{fig:cwlaser}{{1}{10}{CW laser validation. A: Power calibration ($\langle |E|^2\rangle $ vs $P_{\text {dBm}}$). B: Phase diffusion (cumulative squared phase increments $\sum \Delta \phi ^2$ vs $D_\phi t$). C: Phase increment PDF (Gaussian fit). D: RIN spectral density with relaxation-oscillation peak at 5~GHz (Coldren Eq.~5.3.38). E: Polarisation Jones vector ($|E_x|$, $|E_y|$, norm)}{figure.caption.2}{}}
